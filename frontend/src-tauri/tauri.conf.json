{
  "productName": "WarmDesk",
  "version": "0.18.1",
  "identifier": "com.warmdesk.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/build-timer.mjs && npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Self-hosted Kanban and Scrum boards, team chat, and time tracking",
    "category": "Productivity",
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "warmdesk.desktop",
        "files": {
          "/usr/share/applications/warmdesk-timetracking.desktop": "warmdesk-timetracking.desktop",
          "/usr/share/applications/warmdesk-test.desktop": "warmdesk-test.desktop",
          "/usr/share/applications/warmdesk-timetracking-test.desktop": "warmdesk-timetracking-test.desktop",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk.svg": "icons/warmdesk.svg",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk-timetracking.svg": "icons/timetracking.svg",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk-test.svg": "icons/warmdesk-test.svg",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk-timetracking-test.svg": "icons/timetracking-test.svg",
          "/usr/share/icons/hicolor/32x32/apps/warmdesk-timetracking.png": "icons/timetracking-32.png",
          "/usr/share/icons/hicolor/128x128/apps/warmdesk-timetracking.png": "icons/timetracking-128.png",
          "/usr/share/icons/hicolor/256x256/apps/warmdesk-timetracking.png": "icons/timetracking-256.png",
          "/usr/share/icons/hicolor/512x512/apps/warmdesk-timetracking.png": "icons/timetracking-512.png",
          "/usr/share/icons/hicolor/32x32/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-32.png",
          "/usr/share/icons/hicolor/128x128/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-128.png",
          "/usr/share/icons/hicolor/256x256/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-256.png",
          "/usr/share/icons/hicolor/512x512/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-512.png",
          "/usr/bin/warmdesk-timer": "bin/warmdesk-timer"
        }
      },
      "rpm": {
        "depends": [],
        "desktopTemplate": "warmdesk.desktop",
        "files": {
          "/usr/share/applications/warmdesk-timetracking.desktop": "warmdesk-timetracking.desktop",
          "/usr/share/applications/warmdesk-test.desktop": "warmdesk-test.desktop",
          "/usr/share/applications/warmdesk-timetracking-test.desktop": "warmdesk-timetracking-test.desktop",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk.svg": "icons/warmdesk.svg",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk-timetracking.svg": "icons/timetracking.svg",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk-test.svg": "icons/warmdesk-test.svg",
          "/usr/share/icons/hicolor/scalable/apps/warmdesk-timetracking-test.svg": "icons/timetracking-test.svg",
          "/usr/share/icons/hicolor/32x32/apps/warmdesk-timetracking.png": "icons/timetracking-32.png",
          "/usr/share/icons/hicolor/128x128/apps/warmdesk-timetracking.png": "icons/timetracking-128.png",
          "/usr/share/icons/hicolor/256x256/apps/warmdesk-timetracking.png": "icons/timetracking-256.png",
          "/usr/share/icons/hicolor/512x512/apps/warmdesk-timetracking.png": "icons/timetracking-512.png",
          "/usr/share/icons/hicolor/32x32/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-32.png",
          "/usr/share/icons/hicolor/128x128/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-128.png",
          "/usr/share/icons/hicolor/256x256/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-256.png",
          "/usr/share/icons/hicolor/512x512/apps/warmdesk-timetracking-test.png": "icons/timetracking-test-512.png",
          "/usr/bin/warmdesk-timer": "bin/warmdesk-timer"
        }
      }
    }
  }
}
