meta {
  name: Time Report
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/reports/time
  body: none
  auth: bearer
}

params:query {
  period: month
  year:
  month:
  project: {{projectSlug}}
  assignees:
}

auth:bearer {
  token: {{token}}
}

docs {
  Board time report (time spent on cards). period: "all" (default), "year", "month", or "week".
  year / month / week pick the period (default: the current one; week is the ISO week number).
  project: a project slug (default: all projects you can view). assignees: comma-separated user ids.
}
