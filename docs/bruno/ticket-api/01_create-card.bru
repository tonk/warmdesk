meta {
  name: Create Card (Ticket API)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ticket/{{projectSlug}}/cards
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "title": "Fix regression in payment flow",
    "description": "Detected by CI pipeline — see build #1234.",
    "priority": "high",
    "column": "Backlog"
  }
}

docs {
  Authenticate with the X-API-Key header.
  Generate an API key in User Settings or Project Settings.
}
