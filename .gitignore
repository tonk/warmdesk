# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/settings.local.json
.claude/memory/
.claude/worktrees/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
/warmdesk
warmdesk.db
warmdesk-*.tar.gz
ansible/*.tar.gz
ansible/warmdesk
backend/warmdesk

# ── Embedded web files (populated by embed-web Makefile target, not tracked) ─
backend/staticweb/files/*
!backend/staticweb/files/placeholder

# ── Go ───────────────────────────────────────────────────────────────────────
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/vendor/

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.vite/
frontend/dist/

# ── Tauri / Desktop app build artifacts ──────────────────────────────────────
frontend/src-tauri/target/
frontend/src-tauri/gen/
frontend/src-tauri/bin/
# Packaged installers/bundles (AppImage, DMG, MSI, NSIS, deb, rpm, etc.)
frontend/src-tauri/target/release/bundle/
frontend/src-tauri/Cargo.lock

# ── Runtime data ─────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.log

# ── Config (keep the example, ignore local overrides) ────────────────────────
warmdesk.yaml
*.local.yaml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── OS / editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
backend/seed
backend/training

# ── Ansible Collection ────────────────────────────────────────────────────────
ansilabnl-warmdesk-*.tar.gz

# ── Other, temporary files ────────────────────────────────────────────────────
resume

# ── Docs PDF build artefacts (copied/generated by make docs-pdf-assets) ────────
docs/*.pdf
docs/pdf-theme/fonts/*.ttf
docs/pdf-theme/warmdesk-title-logo.png
