---
# WarmDesk configuration file
# Environment variables override any value set here.

# HTTP port the server listens on
port: "8080"

# Database driver: sqlite | mysql | postgres
db_driver: sqlite

# SQLite (default) — path to the database file
db_dsn: "./warmdesk.db"

# PostgreSQL example:
# db_driver: postgres
# db_dsn: "host=localhost user=warmdesk password=secret dbname=warmdesk port=5432 sslmode=disable"

# MySQL / MariaDB example:
# parseTime=True is REQUIRED — the server refuses to start without it (without
# it, DATETIME columns fail to scan into Go's time.Time, and every read of a
# row with a timestamp column silently fails).
# db_driver: mysql
# db_dsn: "warmdesk:secret@tcp(localhost:3306)/warmdesk?charset=utf8mb4&parseTime=True&loc=Local"

# Database TLS (PostgreSQL and MySQL only; not applicable to SQLite).
# db_tls_mode controls the level of certificate verification:
#   disable      — no TLS (default)
#   require      — encrypt the connection but do not verify the server certificate
#   verify-ca    — verify the server certificate was signed by a trusted CA
#   verify-full  — verify the server certificate AND that the hostname matches
#
# ⚠ STRONGLY ADVISED: if your database server is not on the same host as WarmDesk,
# set db_tls_mode to "verify-full" (or at minimum "verify-ca") to encrypt the
# connection and prevent credential interception or man-in-the-middle attacks.
# Leaving this at "disable" means all queries, including passwords and session data,
# travel in plaintext between the application and the database.
#
# Env var overrides: DB_TLS_MODE, DB_TLS_CA_CERT, DB_TLS_CERT, DB_TLS_KEY
#
# db_tls_mode: "verify-full"
# db_tls_ca_cert: "/etc/ssl/warmdesk/ca.pem"      # CA certificate (verify-ca / verify-full)
# db_tls_cert: "/etc/ssl/warmdesk/client.crt"     # client certificate (mTLS, optional)
# db_tls_key: "/etc/ssl/warmdesk/client.key"      # client private key  (mTLS, optional)

# SMTP email settings (used for notifications: mentions, DMs, card assignments).
# These values are used as initial defaults; they can be overridden via the admin
# panel (Admin → Settings → Email) without requiring a server restart.
# Leave smtp.host empty to disable outbound email entirely.
smtp:
  host: ""             # e.g. mail.example.com or smtp.gmail.com
  port: 587            # 587 for STARTTLS (recommended), 465 for SSL, 25 for plaintext
  from: ""             # e.g. warmdesk@example.com
  username: ""         # SMTP login (often the same as the from address)
  password: ""         # SMTP password or app-specific password

# Server TLS — serve HTTPS directly without a reverse proxy.
# Both tls_cert and tls_key must be set to enable HTTPS; if either is absent
# the server starts in plain HTTP mode (suitable when TLS is terminated upstream).
# Env var overrides: TLS_CERT, TLS_KEY
#
# tls_cert: "/etc/ssl/warmdesk/server.crt"
# tls_key:  "/etc/ssl/warmdesk/server.key"

# Public base URL of this WarmDesk instance (scheme + host + optional port).
# Used to set the correct host in the Swagger UI so "Try it out" requests
# reach the right server. Leave empty to keep the default (localhost:8080).
# Env var override: BASE_URL
# base_url: "https://desk.example.com"

# Secret used to sign JWT tokens.
# REQUIRED: set this to a long random string before running in production.
# The server will refuse to start if this value is still "change-me-in-production".
# Generate one with: openssl rand -hex 32
jwt_secret: "change-me-in-production"

# Comma-separated list of allowed CORS origins.
# Do NOT use * in production — the server will refuse to start with gin_mode: release and a wildcard here.
# Example: "https://desk.example.com"
allowed_origins: "http://localhost:5173"

# Comma-separated list of trusted reverse-proxy IP addresses or CIDR ranges.
# When set, Gin reads the real client IP from the X-Forwarded-For header sent
# by these proxies (used in auth logs and rate limiting).
# Leave empty (the default) to trust no proxy headers and always use the direct
# TCP connection address.
# Env var override: TRUSTED_PROXIES
# Examples:
#   trusted_proxies: "127.0.0.1"                 # local reverse proxy (nginx/Apache on same host)
#   trusted_proxies: "127.0.0.1, 10.0.0.0/8"    # local proxy + internal network
# trusted_proxies: ""
#
# Reverse-proxy templates in deploy/ set X-Forwarded-Proto on HTTPS vhosts.
# WarmDesk uses that header (or direct TLS) to mark httpOnly auth and MFA-trust
# cookies as Secure. Ensure your proxy forwards it when TLS terminates upstream.

# Override path for the frontend files. The web UI is embedded in the binary
# by default, so this is only needed to serve a custom or updated frontend
# without rebuilding the binary. Leave empty (or omit) to use the embedded UI.
# web_dir: ""

# LiveKit — group video/audio calls (optional).
# When configured, WarmDesk can issue LiveKit access tokens so users can join
# multi-person video/audio rooms. Without these settings the endpoint returns
# 503 and the existing 1-on-1 call system continues to work as normal.
#
# livekit_url      — the WebSocket address of your LiveKit server.
#                    Use wss:// (secure) in production, ws:// only for local testing.
# livekit_api_key  — the API key you set in your LiveKit server config (livekit.yaml).
# livekit_api_secret — the matching API secret. Keep this private; it signs the tokens.
#
# Env var overrides: LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
#
# livekit_url: "wss://livekit.yourcompany.com"
# livekit_api_key: "APIxxxxxxxxxxxxxxxx"
# livekit_api_secret: "a_long_random_secret_string"

# TURN server — 1-on-1 call relay (strongly recommended for anything but a
# local LAN). WarmDesk's 1-on-1 calls use two public Google STUN servers by
# default, which is enough to discover peers on the same network but cannot
# relay media across symmetric NATs, CGNAT, or restrictive firewalls — a very
# common setup for home/office networks and VPNs. Without a TURN server,
# calls between such peers will connect (signaling succeeds) but show a
# black screen with no audio/video. Any standard TURN server works, e.g.
# coturn (https://github.com/coturn/coturn) with a static long-term
# username/password.
#
# turn_urls       — comma-separated TURN/TURNS URIs, e.g.
#                    "turn:turn.yourcompany.com:3478,turns:turn.yourcompany.com:5349"
# turn_username   — the static username configured on your TURN server.
# turn_credential — the matching password/credential.
#
# Env var overrides: TURN_URLS, TURN_USERNAME, TURN_CREDENTIAL
#
# turn_urls: "turn:turn.yourcompany.com:3478"
# turn_username: "warmdesk"
# turn_credential: "a_long_random_secret_string"

# IMAP mailbox settings.
# The poller reads new messages from `mailbox` (default INBOX) and moves each
# processed message to `processed_mailbox` (default Processed) so it is never
# turned into a duplicate ticket.  The destination folder is created automatically
# if it does not exist.  If the server does not support MOVE the message is
# marked \Seen in place instead.
#
# imap:
#   mailbox: "INBOX"       # source folder to poll
#   processed_mailbox: "Processed"   # destination after a ticket is created

# IMAP OAuth2 client credentials (required for OAuth2-based IMAP authentication).
# These are app-level credentials obtained by registering an OAuth 2.0 application
# with the email provider. They are read at startup — changes require a restart.
#
# ---
# Google (Gmail)
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create a project → OAuth consent screen (External, add scope:
#      https://mail.google.com/)
#   3. Credentials → Create OAuth 2.0 Client ID → Web application
#   4. Add this callback URL as an Authorized Redirect URI:
#      https://your-domain/api/v1/admin/imap/oauth2/callback
#   5. Copy the Client ID and Client Secret below.
#
# google_client_id: "xxxx.apps.googleusercontent.com"
# google_client_secret: "GOCSPX-xxxx"
#
# ---
# Office 365 (Outlook)
#   1. Go to https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
#   2. New registration → name it → Accounts in any organizational directory
#      + personal Microsoft accounts
#   3. Redirect URI: Web → https://your-domain/api/v1/admin/imap/oauth2/callback
#   4. Certificates & secrets → create a client secret
#   5. API permissions → Add permission → Microsoft Graph → Delegated →
#      IMAP.AccessAsUser.All + offline_access
#   6. Copy the Application (client) ID and secret below.
#
# office_client_id: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# office_client_secret: "xxxx~xxxx"
#
oauth2:
  google_client_id: ""
  google_client_secret: ""
  office_client_id: ""
  office_client_secret: ""

# Redis URL for horizontal scaling (optional).
# When set, WebSocket broadcasts are routed through Redis pub/sub so all
# server instances deliver the message to their connected clients.
# Omit or leave empty for single-instance deployments (no Redis needed).
# redis_url: "redis://localhost:6379/0"

# Default UI language for new users (en | nl | de | fr | es | da | sv | nb | fi | is | pt | it). Defaults to "en".
# Can be overridden per-user in their profile settings.
# default_locale: "en"

# Application mode. Defaults to "" (full WarmDesk).
# Set to "timetracking" to run as a time-tracking-only server:
#   - Boards, chat, and helpdesk API routes are disabled.
#   - The time-tracking logos (clock-on-desk) replace the default WarmDesk logos
#     in the web UI and in exported PDFs (when no custom company logo is set).
# Set to "ticketsystem" to run as a ticket-system-only server:
#   - Boards/projects, chat, and time-tracking API routes are disabled; only the
#     helpdesk (customers, tickets, knowledge base, CMDB, changes) remains.
#   - The ticket logos (ticket-on-desk) replace the default WarmDesk logos in the
#     web UI and in exported PDFs, and the login page shows "Ticket system only".
# Set to "board" to run as a board-only server:
#   - Time-tracking (incl. reports and invoices) and helpdesk API routes are disabled;
#     boards/projects, topics and chat remain. The default WarmDesk logos are used and
#     the login page shows "Board only".
# Can also be passed as the --mode=timetracking / --mode=ticketsystem / --mode=board CLI flag (takes precedence over this setting).
# Can also be set via the APP_MODE environment variable.
# app_mode: "timetracking"

# Instance mode. Defaults to "" (production).
# Set to "test" to mark this server as a test/staging instance:
#   - The logo variants swap to an orange palette with a "TEST" corner ribbon
#     (logo-test.svg / logo-full-test.svg, or timetracking-test.svg /
#     timetracking-full-test.svg when app_mode is "timetracking", or ticketsystem-test.svg /
#     ticketsystem-full-test.svg when it is "ticketsystem") in the web UI
#     and in exported PDFs (when no custom company logo is set).
#   - Combines independently with app_mode — e.g. app_mode: "timetracking" +
#     instance_mode: "test" serves the orange time-tracking logos.
# Can also be passed as the --instance-mode=test CLI flag (takes precedence over this setting).
# Can also be set via the INSTANCE_MODE environment variable.
# instance_mode: "test"

# Gin framework mode: debug | release. Defaults to "release".
# Set to "debug" during development to enable verbose request logging and detailed errors.
# Can also be set via the GIN_MODE environment variable.
# gin_mode: "debug"

# Database query logging level: silent | error | warn | info. Defaults to "info".
# Set to "silent" or "error" in production to suppress per-query log output.
# Can also be set via the DB_LOG environment variable.
# db_log: "silent"

# Log incoming HTTP requests. Defaults to true.
# Set to false to suppress per-request log lines (e.g. in production behind a reverse proxy).
# Can also be set via the API_LOG environment variable (API_LOG=false to disable).
# api_log: false
